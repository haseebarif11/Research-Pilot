# =============================================================================
# ResearchPilot — Environment Variables
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# Then fill in the values below.
#
# For Hugging Face Spaces, set these as Space Secrets instead of committing
# them to the repo (Settings → Variables and secrets).
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Backend selection
# -----------------------------------------------------------------------------
# "ollama"       → local Ollama daemon (default for local dev, free, 100% offline)
# "hf_inference" → Hugging Face serverless Inference API (required for HF Spaces)
LLM_BACKEND=ollama

# -----------------------------------------------------------------------------
# Hugging Face Inference API (required when LLM_BACKEND=hf_inference)
# -----------------------------------------------------------------------------
# Generate a free READ token at: https://huggingface.co/settings/tokens
# No credit card required. The free serverless tier supports the models below.
HF_TOKEN=hf_YOUR_TOKEN_HERE

# Optional: override the default inference model.
# Free serverless models (ungated, confirmed on HF free-tier Inference Providers router):
#   Qwen/Qwen2.5-7B-Instruct           ← default (higher quality, ungated, free tier)
#   meta-llama/Llama-3.2-3B-Instruct   ← faster alternative, also free tier
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# -----------------------------------------------------------------------------
# Local Ollama settings (only used when LLM_BACKEND=ollama)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
